# GEMINI_API_KEY: Required for Gemini AI API calls via @google/genai.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# OPENAI_API_KEY: Optional if using the OpenAI provider adapter (MODEL_PROVIDER="openai")
OPENAI_API_KEY="YOUR_OPENAI_API_KEY"

# MODEL_PROVIDER: "gemini" (default in AI Studio) or "openai"
MODEL_PROVIDER="gemini"

# MODEL_NAME: Configurable model identifier (default: "gemini-3.8-flash" or "gpt-4o-mini")
MODEL_NAME="gemini-3.8-flash"

# DATABASE_PATH: Local SQLite database path for persistent tasks, conversations, and agent activity
DATABASE_PATH="./studypilot.db"

# MAX_TOOL_ITERATIONS: Strict upper bound on agent tool execution loop per turn
MAX_TOOL_ITERATIONS="5"

# CORS_ORIGINS: Comma-separated list of allowed origins
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

